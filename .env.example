# The /setup screen writes this file for you — you don't need to edit it by hand.
# (copy to .env ON THE SERVER; never commit it)
#
# NOTE: AI providers and their keys are NOT stored here anymore. They live in
# config/providers.local.json (also git-ignored) and are managed on the /setup
# "AI providers" and "Who runs what" screens. This file only holds the website
# mode and the optional extras.

SITE_MODE=readonly
SITE_URL=

# ---- optional (not required to start) --------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# ntfy is how the agency reaches you. Make the topic long and random — anyone
# who guesses the name reads your notifications.
NTFY_TOPIC=
NTFY_SERVER=
# Telegram is still READ if these are already set, so an older setup keeps
# working, but nothing writes them now.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OUTREACH_DOMAIN=
DAILY_SPEND_CAP_USD=15
OUTREACH_DAILY_CAP=25

# ---- search on YOUR OWN site (Algolia) -------------------------------------
# The app id and the SEARCH key are public by design — the search box queries
# from a visitor's browser. The WRITE key is not: it can delete every record in
# your index, it stays on this machine, and the widget builder refuses to hand
# over a snippet containing it.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
ALGOLIA_WRITE_KEY=
ALGOLIA_INDEX=

# ---- what a crawler fetch costs you ----------------------------------------
# Zyte bills per SUCCESSFUL request and the price depends on the target site and
# your volume discount, so there is no number to hardcode. These are your own
# estimates from an invoice or Zyte's cost estimator; leave them blank and the
# cheapest tier is assumed. Requests are counted exactly either way — only the
# money column is an estimate. See coordination/usage.py.
ZYTE_COST_PER_FETCH=
ZYTE_COST_PER_RENDER=
# Your own site never blocks you, so it is read for free. Set to 1 only if some
# of your pages are built by JavaScript and turn up blank in the search index.
CRAWLER_ON_OWN_SITE=
# Plan allowances, if yours differ from the published free tier
# (10,000 searches/month, 50,000 records).
ALGOLIA_SEARCH_ALLOWANCE=
ALGOLIA_RECORD_ALLOWANCE=

# ---- integrations (set on /setup → Integrations) --------------------------
# Email delivery (SMTP) — outreach, replies, graphical emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
# WhatsApp Business (Meta WhatsApp Cloud API)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_BUSINESS_ID=
# Google Search Console — the service-account JSON key lives in
# config/gsc-service-account.local.json (git-ignored), not here
GSC_PROPERTY=

# ---- website full-access (only if you chose Full access) -------------------
SITE_API_BASE=
SITE_API_TOKEN=

PORT=3000
