# The /setup screen writes this file for you — you don't need to edit it by hand.
# (copy to .env ON THE SERVER; never commit it)

SITE_MODE=readonly
SITE_URL=

# ---- AI providers: one slot per brain -------------------------------------
# Each slot = provider name, base URL (endpoint), model, API key.
# Base URL is required for providers like Forge / Agent Router; leave it blank
# only for official Anthropic. Fill MD first; empty sectors use FALLBACK.

# MD = Managing Director + Critic (your most advanced model)
MD_PROVIDER=
MD_BASE_URL=
MD_MODEL=
MD_API_KEY=

# FALLBACK = used if any key fails, and spare capacity for the MD
FALLBACK_PROVIDER=
FALLBACK_BASE_URL=
FALLBACK_MODEL=
FALLBACK_API_KEY=

# one slot per sector
IT_PROVIDER=
IT_BASE_URL=
IT_MODEL=
IT_API_KEY=

CONTENT_PROVIDER=
CONTENT_BASE_URL=
CONTENT_MODEL=
CONTENT_API_KEY=

SEO_PROVIDER=
SEO_BASE_URL=
SEO_MODEL=
SEO_API_KEY=

LEADS_PROVIDER=
LEADS_BASE_URL=
LEADS_MODEL=
LEADS_API_KEY=

REPORT_PROVIDER=
REPORT_BASE_URL=
REPORT_MODEL=
REPORT_API_KEY=

SECURITY_PROVIDER=
SECURITY_BASE_URL=
SECURITY_MODEL=
SECURITY_API_KEY=

# ---- optional (not required to start) --------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OUTREACH_DOMAIN=
DAILY_SPEND_CAP_USD=15
OUTREACH_DAILY_CAP=25

# ---- website full-access (only if you chose Full access) -------------------
SITE_API_BASE=
SITE_API_TOKEN=

PORT=3000
