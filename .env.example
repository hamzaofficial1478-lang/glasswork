# The /setup screen writes this file for you — you don't need to edit it by hand.
# (copy to .env ON THE SERVER; never commit it)
#
# NOTE: AI providers and their keys are NOT stored here anymore. They live in
# config/providers.local.json (also git-ignored) and are managed on the /setup
# "AI providers" and "Who runs what" screens. This file only holds the website
# mode and the optional extras.

SITE_MODE=readonly
SITE_URL=

# ---- optional (not required to start) --------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OUTREACH_DOMAIN=
DAILY_SPEND_CAP_USD=15
OUTREACH_DAILY_CAP=25

# ---- website full-access (only if you chose Full access) -------------------
SITE_API_BASE=
SITE_API_TOKEN=

PORT=3000
